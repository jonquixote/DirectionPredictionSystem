# ofi-lab-v3 environment configuration
# Copy to /etc/v3/env and customize for your deployment

# ── Core deployment ──────────────────────────────────────────────
V3_ENV=prod
V3_ADMIN_SECRET=<generate-via-scripts/generate_admin_secret.sh>

# ── Storage ──────────────────────────────────────────────────────
V3_DB_PATH=/data/v3.db
V3_KILL_SWITCH_PATH=/data/kill_switch.json

# ── API credentials ──────────────────────────────────────────────
BYBIT_API_KEY=<your-bybit-key>
BYBIT_API_SECRET=<your-bybit-secret>

# ── Dashboard auth (optional — if unset, dev mode) ──────────────
# DASHBOARD_USER=admin
# DASHBOARD_PASS=<secure-password>

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Feature flags ────────────────────────────────────────────────
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
