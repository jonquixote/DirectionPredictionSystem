[Unit]
Description=ofi-lab-v3 dashboard API
After=network.target

[Service]
Type=simple
User=johnny
WorkingDirectory=/home/johnny/ofi-lab-v3
EnvironmentFile=/etc/v3/env
Environment="PYTHONPATH=/home/johnny/ofi-lab-v3:/home/johnny/ofi-lab-v3/dashboard_api"
ExecStart=/home/johnny/ofi-lab-v3/.venv/bin/uvicorn dashboard_api.main:app --host 127.0.0.1 --port 8081 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=v3-dashboard

[Install]
WantedBy=multi-user.target
